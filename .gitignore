# ---- Dependencies ----
node_modules/
**/node_modules/

# ---- Build output ----
.next/
**/.next/
dist/
**/dist/
build/
out/

# ---- Secrets / environment (NEVER commit) ----
.env
.env.*
**/.env
**/.env.*
!**/.env.example

# ---- Reference dump of the OLD WooCommerce site ----
# Contains wp-config.php credentials + a SQL dump with real customer PII.
# Reference-only; must NEVER be published.
reference/

# ---- Local docs / binaries not needed in the code repo ----
*.docx
# Keeps stray database dumps out of the repo. The real PII risk (the old
# WooCommerce APP-DATA.SQL) lives under reference/, which is ignored above.
*.sql
# ...but Prisma migrations ARE source code and must be versioned — without this
# exception the blanket *.sql rule silently drops every migration, leaving the
# repo with no schema history at all.
!backend/prisma/migrations/**/*.sql

# ---- Logs & caches ----
*.log
npm-debug.log*
.turbo/
.cache/

# ---- OS / editor junk ----
.DS_Store
Thumbs.db
.vscode/
.idea/
